{
  "name": "venuebox-desktop-client",
  "productName": "Venuebox",
  "version": "0.2.0",
  "description": "Turns a PC into a Venuebox display player: one TV per screen, paired with a Bar Games box.",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test \"dist/test/**/*.test.js\"",
    "start": "tsc -p . && electron .",
    "start:windowed": "tsc -p . && electron . --windowed",
    "dist:win": "tsc -p . && electron-builder --win",
    "dist:linux": "tsc -p . && electron-builder --linux",
    "dist:mac": "tsc -p . && electron-builder --mac"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.bargames.venuebox",
    "productName": "Venuebox",
    "files": [
      "dist/src/**",
      "static/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Venuebox-Setup-${version}.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    }
  }
}
